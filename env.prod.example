# Runtime
PORT=3000
APP_BASE_URL=https://your-public-domain.example

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASS=CHANGE_ME
DB_NAME=hello
# Empty-database bootstrap only. Keep false after the first schema startup.
DB_SYNCHRONIZE=false
# Keep false during an empty-database bootstrap; enable after it is complete.
RUN_MIGRATIONS=false

# Authentication
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_SECURE=true
CORS_ORIGIN=https://your-public-domain.example
DEV_ACCOUNT=dev
DEV_ACCOUNT_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is stored separately in /etc/secrets/redis.prod.
# REDIS_URL should not be set when using the Compose-managed Redis service.

# Main chat model
MODEL_NAME=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=CHANGE_ME

# Video generation
YUNFEI_API_KEY=CHANGE_ME
YUNFEI_API_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
YUNFEI_API_MODEL=CHANGE_ME
VIDEO_CALLBACK_TOKEN=CHANGE_ME

# Alibaba Cloud OSS
OSS_REGION=CHANGE_ME
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
OSS_BUCKET_NAME=CHANGE_ME
# OSS_TRANSFER_MAX_BYTES=1073741824

# Tencent Cloud speech
SECRET_ID=CHANGE_ME
SECRET_KEY=CHANGE_ME
SECRET_APP_ID=CHANGE_ME
TTS_VOICE_TYPE=CHANGE_ME

# Web search
BOCHA_API_KEY=CHANGE_ME
BOCHA_BASE_URL=CHANGE_ME

# Mail
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=CHANGE_ME

# External Langfuse. Keep disabled unless Cloud or a separate host is ready.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
